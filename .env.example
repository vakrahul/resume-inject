# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Nodemailer (in-process — no mail sidecar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="ResumeGuard Demo <your_email@gmail.com>"

# Blue-team policy (enforced in Node BEFORE Nodemailer.sendMail)
ADMIN_ALERT_EMAIL=admin@company.com
EMAIL_DOMAIN_WHITELIST=company.com,internal.company.com

# Servers
PORT=3010
CLIENT_ORIGIN=http://localhost:5174

# Demo safety: set true to log mail instead of sending
MAIL_DRY_RUN=true
